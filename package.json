    "@vitejs/plugin-react": "^5.2.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-chrono": "^3.3.3",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "^7.3.6"
  }
