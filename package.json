{
  "name": "igp-development-platform",
  "version": "0.1.144",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test": "node --test test/*.test.js && npm test --prefix public-entry-gateway",
    "verify": "npm run test && npm run build && npm run verify:upload-log && npm run verify:secret-exposure",
    "deploy-tool:install": "npm ci --prefix deployment-tool",
    "deploy-tool:test": "npm test --prefix deployment-tool",
    "deploy-tool:build": "npm run build --prefix deployment-tool",
    "deploy-tool:package": "npm run package --prefix deployment-tool",
    "deploy:debug": "node scripts/deploy-debug.js",
    "verify:upload-log": "node scripts/verify-upload-log.js",
    "verify:secret-exposure": "node scripts/check-secret-exposure.js",
    "log-change": "node scripts/log-change.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.145.0",
    "express": "^5.1.0",
    "file-type": "22.0.1",
    "officeparser": "7.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-chrono": "^3.3.3",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "^7.3.6"
  }
}
