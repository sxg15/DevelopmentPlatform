server {
    listen 80;
    listen [::]:80;
    server_name 47.100.74.169 kkong.cn;

    client_max_body_size 64k;

    location = /__igp/client-ip {
        default_type text/plain;
        add_header Cache-Control "no-store, max-age=0" always;
        return 200 "$remote_addr\n";
    }

    location = /__igp/offline {
        internal;
        root /var/www/igp-public-entry;
        add_header Cache-Control "no-store, max-age=0" always;
        try_files /offline.html =503;
    }

    location / {
        limit_except GET HEAD {
            deny all;
        }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-IGP-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_redirect off;
        proxy_intercept_errors on;
        error_page 502 504 =503 /__igp/offline;
        proxy_pass http://127.0.0.1:18080;
    }
}
